# Get these from your Plaid dashboard at https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SANDBOX_SECRET=your_plaid_sandbox_secret
PLAID_PROD_SECRET=your_plaid_production_secret
PLAID_ENV=sandbox

# OAuth redirect URI for Plaid Link (required for Chase and other OAuth banks).
# Must match exactly what you add under Plaid Dashboard → Team Settings →
# Allowed redirect URIs. Use your app origin with a trailing slash, no hash.
# Local sandbox:    http://localhost:8000/
# Local production: https://YOUR-ID.ngrok-free.app/  (see NGROK_AUTHTOKEN below)
# Deployed:         https://your-domain.com/
PLAID_REDIRECT_URI=

# ngrok authtoken (free at https://dashboard.ngrok.com/get-started/your-authtoken).
# Required when using ngrok for Plaid OAuth on localhost with production keys.
# After setting this, run: ngrok http 8000   (with venv activated — pip install ngrok)
NGROK_AUTHTOKEN=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not change after accounts are linked -- it breaks decryption of stored tokens.
ENCRYPTION_KEY=

# Authentication is a username/password account created on first run; the
# session token is signed with a key derived from ENCRYPTION_KEY, so nothing
# extra is required for login.
#
# API_KEY (OPTIONAL): legacy/automation credential accepted via X-API-Key.
# AUTH_TOKEN_KEY (OPTIONAL): base64 Fernet key to sign sessions independently
#   of ENCRYPTION_KEY (lets you rotate ENCRYPTION_KEY without logging out).
# SESSION_TTL_DAYS: session lifetime (default 30).
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
AUTH_TOKEN_KEY=
SESSION_TTL_DAYS=30

# Comma-separated extra CORS origins (e.g. your production domain), layered
# on top of the localhost dev defaults. Leave blank for local dev.
CORS_ORIGINS=

LOG_LEVEL=INFO
SYNC_INTERVAL_HOURS=6

# Optional: webhook for alert notifications (budget overages, large
# transactions). Fired by the background sync when a new alert appears.
# Sends JSON {"text": "...", "content": "..."} -- works with Slack, Discord,
# ntfy, Home Assistant, etc. Leave blank to disable. Treat this URL as a
# secret (Slack/Discord webhook URLs embed a token).
ALERT_WEBHOOK_URL=

# --- Only used by docker-compose.prod.yml (self-hosted production stack) ---
# See docs/PRODUCTION_CHECKLIST.md before setting these.
# POSTGRES_DB=ledger
# POSTGRES_USER=ledger_user
# POSTGRES_PASSWORD=              # 30+ random chars; required by docker-compose.prod.yml
# DOMAIN=localhost                # or your real domain for automatic HTTPS via Caddy
