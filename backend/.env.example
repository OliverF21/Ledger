# Get these from your Plaid dashboard at https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_PROD_SECRET=your_plaid_production_secret
PLAID_SANDBOX_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# OAuth redirect URI — see root .env.example and docs/PLAID_SETUP.md
# Local production (ngrok): https://YOUR-ID.ngrok-free.app/
PLAID_REDIRECT_URI=

# ngrok authtoken — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not change after accounts are linked -- it breaks decryption of stored tokens.
ENCRYPTION_KEY=

DATABASE_URL=sqlite:///ledger.db

# Authentication: the app uses a username/password account created on first
# run. The session token is signed/encrypted with a key derived from
# ENCRYPTION_KEY (above), so no extra secret is required for login to work.
#
# API_KEY (OPTIONAL): a legacy/automation credential. When set, requests may
# authenticate with an X-API-Key header instead of a Bearer token (e.g. curl,
# cron). Leave blank to disable that path entirely.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# AUTH_TOKEN_KEY (OPTIONAL): a base64 Fernet key used to sign session tokens
# instead of deriving one from ENCRYPTION_KEY. Set this if you want to rotate
# ENCRYPTION_KEY without logging everyone out. Generate the same way as
# ENCRYPTION_KEY. Leave blank to derive from ENCRYPTION_KEY.
AUTH_TOKEN_KEY=

# Session lifetime in days (default 30). Users re-login after this.
SESSION_TTL_DAYS=30

# Comma-separated extra CORS origins (e.g. your production domain), layered
# on top of the localhost dev defaults. Leave blank for local dev.
CORS_ORIGINS=

# Optional: webhook for alert notifications (budget overages, large
# transactions). Fired by the background sync when a new alert appears.
# Sends JSON {"text": "...", "content": "..."} -- works with Slack, Discord,
# ntfy, Home Assistant, etc. Leave blank to disable. Treat this URL as a
# secret (Slack/Discord webhook URLs embed a token).
ALERT_WEBHOOK_URL=

# ── Weekly summary email (OPTIONAL) ──────────────────────────────────────────
# A weekly spending-vs-budget summary, sent via Resend (https://resend.com).
# We use a send-only Resend API key rather than an SMTP mailbox password: a
# leaked key can only send mail through Resend (revoke it in their dashboard),
# never read an inbox or touch a Google account.
#
# RESEND_API_KEY enables the *transport*; the on/off toggle and recipient
# address are set in the app (Settings > Weekly email), not here, so they can
# be changed without a restart. Leave RESEND_API_KEY blank to disable the
# feature entirely regardless of the in-app toggle.
# Get a key at resend.com/api-keys (free tier: 3k emails/month).
RESEND_API_KEY=
# Sender. Defaults to Resend's shared onboarding@resend.dev (works without
# domain verification, good for testing). Set to an address on your own
# verified domain for production, e.g. "Ledger <ledger@yourdomain.com>".
WEEKLY_EMAIL_FROM=
# When to send (server local time). Day-of-week: mon,tue,...,sun. Hour: 0-23.
WEEKLY_EMAIL_DOW=mon
WEEKLY_EMAIL_HOUR=8

# ── Password reset email (OPTIONAL, but strongly recommended) ───────────────
# A SEPARATE Resend key reserved ONLY for password-reset emails — never used
# for the weekly digest above, and never used for anything else. This is what
# lets you recover a forgotten password by email without having bothered to
# set up RESEND_API_KEY/weekly email at all. Can also be set via the setup
# wizard or Settings > Recovery email (BYOK, encrypted at rest) — this env
# var is just an alternative for manual/self-hosted deployments.
# Get a key at resend.com/api-keys (a free-tier key works fine here too).
# Leave blank to disable email-based reset — the account then falls back to
# the recovery-code flow only (Settings > Recovery code).
RESET_EMERGENCY_RESEND_API_KEY=

# ── AI Advisor / MCP proposals (OPTIONAL) ────────────────────────────────────
# The MCP server's propose_budget tool stages budget suggestions that you apply
# in the app's Advisor page. This key is a SCOPED, create-only credential: it is
# accepted ONLY on POST /api/proposals — never on sync, categorize, or apply.
# It is deliberately separate from API_KEY (which authenticates every route).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to disable proposal creation (the endpoint returns 503).
PROPOSAL_SERVICE_KEY=
# Days a pending proposal lives before the scheduler marks it expired.
PROPOSAL_TTL_DAYS=7
# Where the MCP server reaches the backend API and where the user's browser
# reaches the app (for the clickable apply link). Same host by default; set
# LEDGER_APP_URL to your Tailscale MagicDNS URL, e.g. http://ledger:8000.
LEDGER_API_URL=http://127.0.0.1:8000
LEDGER_APP_URL=http://127.0.0.1:8000

# ── Crypto wallets / Robinhood Chain (OPTIONAL) ──────────────────────────────
# Desktop app: set this in Settings → Crypto wallets (encrypted at rest via
# app_config). This env var is only a fallback for source/self-hosted installs.
# Create a free Alchemy app with Robinhood Chain Mainnet:
# https://dashboard.alchemy.com/
ALCHEMY_API_KEY=
