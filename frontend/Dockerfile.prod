# Production frontend image: builds the static bundle, then serves it (and
# reverse-proxies the backend) through Caddy for automatic HTTPS. Used only
# by docker-compose.prod.yml -- local dev keeps using Dockerfile.dev.

FROM node:18-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# No build-time secrets: auth is username/password at runtime (Bearer token
# in localStorage), so nothing sensitive is baked into the static bundle.
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
