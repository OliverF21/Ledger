# Caddy config for the production stack (docker-compose.prod.yml).
# Serves the built frontend as static files and reverse-proxies API/docs
# requests to the backend container, all on one origin -- so the frontend's
# relative /api fetches (see src/api/client.ts) work without extra CORS setup.
#
# DOMAIN defaults to "localhost" (self-signed cert, browser will warn).
# Point it at a real domain name with DNS pointed at this host to get
# automatic Let's Encrypt HTTPS instead. If you're only reachable over a
# VPN/Tailscale tailnet, plain "localhost" is fine -- the tunnel already
# encrypts the traffic.
{$DOMAIN:localhost} {
	encode gzip

	@backend path /api/* /health /docs* /openapi.json /redoc*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Optional: gate the entire app behind a login. Recommended if this will
	# ever be reachable outside a VPN/Tailscale-only network (see SECURITY.md
	# section 6). Generate a hash with:
	#   docker run --rm caddy:2-alpine caddy hash-password
	# basic_auth {
	# 	<username> <bcrypt-hash>
	# }
}
